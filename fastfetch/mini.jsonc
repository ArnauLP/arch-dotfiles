// Compact pfetch-style preset:  fastfetch -c mini
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "color": { "1": "cyan" },
        "padding": { "top": 1, "left": 2, "right": 3 }
    },
    "display": {
        "separator": "  ",
        "key": { "width": 11 },
        "color": { "keys": "blue", "title": "magenta" },
        "size": { "binaryPrefix": "jedec" }
    },
    "modules": [
        { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}" },
        { "type": "custom", "format": "\u001b[90m──────────────────────────────" },
        { "type": "os",       "key": "󰣇  os",      "keyColor": "cyan",    "format": "{name}" },
        { "type": "host",     "key": "󰌢  host",    "keyColor": "cyan",    "format": "{name}" },
        { "type": "kernel",   "key": "󰌽  kernel",  "keyColor": "blue",    "format": "{release}" },
        { "type": "uptime",   "key": "󰅐  uptime",  "keyColor": "blue",    "format": "{?days}{days}d {?}{hours}h {minutes}m" },
        { "type": "packages", "key": "󰏖  pkgs",    "keyColor": "magenta", "format": "{all} ({pacman} pacman, {flatpak-user} flatpak)" },
        { "type": "wm",       "key": "󰖯  wm",      "keyColor": "magenta", "format": "{pretty-name}" },
        { "type": "terminal", "key": "󰆍  term",    "keyColor": "yellow",  "format": "{pretty-name}" },
        { "type": "terminalfont", "key": "󰛖  font",    "keyColor": "yellow" },
        { "type": "shell",    "key": "󱆃  shell",   "keyColor": "yellow",  "format": "{pretty-name}" },
        { "type": "memory",   "key": "󰍛  memory",  "keyColor": "red" },
        "break",
        { "type": "colors", "symbol": "circle" },
        "break",
        { "type": "command", "key": " ", "keyWidth": 1, "separator": "", "text": "shuf -n1 ~/.config/fastfetch/quotes.txt", "format": "\u001b[3;38;2;147;154;183m“{}”" }
    ]
}
